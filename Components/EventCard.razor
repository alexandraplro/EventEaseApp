@using EventEaseApp.Models
@inject NavigationManager NavManager

<div class="ee-card">
    <div class="ee-card-header">
        <h3>@EventData?.Name</h3>
    </div>

    <div class="ee-card-meta">
        <div>@EventData?.Date.ToString("MMM dd, yyyy") • @EventData?.Location</div>
    </div>

    <div class="ee-card-desc">
        @EventData?.Description
    </div>

    <div class="ee-card-actions">
        <button class="btn ee-btn-primary" @onclick="Register">
            <i class="bi bi-pencil-square"></i> Register
        </button>
    </div>
</div>

@code {
    [Parameter]
    public Event? EventData { get; set; }   // 👈 This goes here

    private void Register()
    {
        NavManager.NavigateTo("/register");
    }
}
