@page "/register"
@using EventEaseApp.Models
@using EventEaseApp.Services
@inject RegistrationService RegistrationService
@inject EventService EventService
@inject SessionService SessionService

<div class="container text-center">
    <h2 class="mb-4">📝 Register for an Event</h2>

    <EditForm Model="registration" OnValidSubmit="HandleValidSubmit">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="mb-3 text-start">
            <label class="form-label">Name</label>
            <InputText class="form-control" @bind-Value="registration.Name" />
            <ValidationMessage For="@(() => registration.Name)" />
        </div>

        <div class="mb-3 text-start">
            <label class="form-label">Email</label>
            <InputText class="form-control" @bind-Value="registration.Email" />
            <ValidationMessage For="@(() => registration.Email)" />
        </div>

        <div class="mb-3 text-start">
            <label class="form-label">Event</label>
            <InputSelect class="form-control" @bind-Value="registration.EventName">
                <option value="">-- Select Event --</option>
                @foreach (var ev in EventService.GetEvents())
                {
                    <option value="@ev.Name">@ev.Name</option>
                }
            </InputSelect>
            <ValidationMessage For="@(() => registration.EventName)" />
        </div>

        <button type="submit" class="btn btn-success rounded-pill shadow-sm">
            Register
        </button>
    </EditForm>

    @if (successMessage != null)
    {
        <div class="alert alert-success mt-3">@successMessage</div>
    }
</div>

@code {
    private Registration registration = new();
    private string? successMessage;

    private void HandleValidSubmit()
    {
        RegistrationService.AddRegistration(registration);

        // Store session info
        SessionService.CurrentUserName = registration.Name;
        SessionService.CurrentUserEmail = registration.Email;
        SessionService.UserRegistrations.Add(registration);

        successMessage = $"✅ {registration.Name} registered for {registration.EventName}!";
        registration = new Registration(); // reset form
    }
}
