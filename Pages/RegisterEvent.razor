@page "/registerevent/{EventName}"
@using EventEaseApp.Models
@using EventEaseApp.Services
@inject RegistrationService RegistrationService
@inject SessionService SessionService

<div class="event-card">
    <h3><i class="bi bi-pencil-square"></i> Register for @EventName</h3>

    <EditForm Model="registration" OnValidSubmit="HandleValidSubmit">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="form-group">
            <label for="name">Name</label>
            <InputText id="name" class="form-control" @bind-Value="registration.Name" />
            <ValidationMessage For="@(() => registration.Name)" />
        </div>

        <div class="form-group">
            <label for="email">Email</label>
            <InputText id="email" class="form-control" @bind-Value="registration.Email" />
            <ValidationMessage For="@(() => registration.Email)" />
        </div>

        <button type="submit" class="btn rounded-pill shadow-sm">Register</button>
    </EditForm>

    @if (successMessage != null)
    {
        <div class="alert alert-success mt-3">@successMessage</div>
    }
</div>

@code {
    [Parameter] public string EventName { get; set; } = string.Empty;

    private Registration registration = new();
    private string? successMessage;

    protected override void OnInitialized()
    {
        registration.EventName = EventName;
    }

    private void HandleValidSubmit()
    {
        RegistrationService.AddRegistration(registration);
        successMessage = $"Successfully registered {registration.Name} for {registration.EventName}!";
        registration = new() { EventName = EventName };
    }
}
