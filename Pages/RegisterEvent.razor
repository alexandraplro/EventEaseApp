@page "/eventregistration/{EventName}"
@using EventEaseApp.Models
@using EventEaseApp.Services
@inject RegistrationService RegistrationService

<section class="ee-section">
    <h2 class="ee-section-title"><i class="bi bi-pencil-square"></i> Register for @EventName</h2>

    <EditForm Model="registration" OnValidSubmit="HandleValidSubmit">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="mb-3">
            <label class="form-label">Name</label>
            <InputText class="form-control" @bind-Value="registration.Name" />
        </div>

        <div class="mb-3">
            <label class="form-label">Email</label>
            <InputText class="form-control" @bind-Value="registration.Email" />
        </div>

        <button type="submit" class="btn ee-btn-secondary">
            <i class="bi bi-check2-circle"></i> Register
        </button>
    </EditForm>

    @if (!string.IsNullOrEmpty(successMessage))
    {
        <div class="alert alert-success mt-3">@successMessage</div>
    }
</section>

@code {
    [Parameter] public string EventName { get; set; } = string.Empty;

    private Registration registration = new();
    private string? successMessage;

    protected override void OnInitialized()
    {
        registration.EventName = EventName;
    }

    private void HandleValidSubmit()
    {
        RegistrationService.AddRegistration(registration);
        successMessage = $"Successfully registered {registration.Name} for {registration.EventName}.";
        registration = new() { EventName = EventName };
    }
}
