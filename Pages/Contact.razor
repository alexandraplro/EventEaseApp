@page "/contact"
@using EventEaseApp.Models

<section class="ee-section">
    <h2 class="ee-section-title"><i class="bi bi-envelope"></i> Contact Us</h2>

    <EditForm Model="message" OnValidSubmit="HandleValidSubmit">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="mb-3">
            <label class="form-label">Name</label>
            <InputText class="form-control" @bind-Value="message.Name" />
            <ValidationMessage For="@(() => message.Name)" />
        </div>

        <div class="mb-3">
            <label class="form-label">Email</label>
            <InputText class="form-control" @bind-Value="message.Email" />
            <ValidationMessage For="@(() => message.Email)" />
        </div>

        <div class="mb-3">
            <label class="form-label">Comment</label>
            <InputTextArea class="form-control" @bind-Value="message.Comment" Rows="5" />
            <ValidationMessage For="@(() => message.Comment)" />
        </div>

        <button type="submit" class="btn ee-btn-primary">
            <i class="bi bi-send"></i> Submit
        </button>
    </EditForm>

    @if (!string.IsNullOrEmpty(successMessage))
    {
        <div class="alert alert-success mt-3">@successMessage</div>
    }
</section>

@code {
    private ContactMessage message = new();
    private string? successMessage;

    private void HandleValidSubmit()
    {
        // In a real app, you’d save or send the message here
        successMessage = $"Thank you, {message.Name}. Your message has been received.";
        message = new ContactMessage();
    }
}
