@page "/"
@using EventEaseApp.Models
@inject EventService EventService

<section class="ee-section">
    <h2 class="ee-section-title text-center">
    <i class="bi bi-calendar3"></i> EXPLORE UPCOMING EVENTS!
    </h2>

    <div class="ee-grid">
        @foreach (var ev in EventService.GetEvents())
        {
            <EventCard EventData="ev" />
        }
    </div>
</section>
