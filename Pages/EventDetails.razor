@page "/eventdetails/{eventName}"
@using EventEaseApp.Models
@using EventEaseApp.Services
@inject EventService EventService

<h2>Event Details</h2>

@if (selectedEvent is not null)
{
    <p><strong>Name:</strong> @selectedEvent.Name</p>
    <p><strong>Date:</strong> @selectedEvent.Date.ToString("MMMM dd, yyyy")</p>
    <p><strong>Location:</strong> @selectedEvent.Location</p>

    @if (!string.IsNullOrWhiteSpace(selectedEvent.Description))
    {
        <p><strong>Description:</strong> @selectedEvent.Description</p>
    }

    <NavLink class="btn rounded-pill shadow-sm"
             href="@($"/registerevent/{Uri.EscapeDataString(selectedEvent.Name)}")">
        Register for this event
    </NavLink>
}
else
{
    <p>Event not found. <NavLink href="/">Back to Events</NavLink></p>
}

@code {
    [Parameter] public string? eventName { get; set; }
    private Event? selectedEvent;

    protected override void OnParametersSet()
    {
        if (EventService is not null && !string.IsNullOrEmpty(eventName))
        {
            selectedEvent = EventService.GetEvents()
                .FirstOrDefault(e => e.Name.Equals(eventName, StringComparison.OrdinalIgnoreCase));
        }
    }
}
