@page "/eventdetails/{eventName}"
@using EventEaseApp.Models
@using EventEaseApp.Services

<h2>Event Details</h2>

@if (selectedEvent != null)
{
    <p><strong>Name:</strong> @selectedEvent.Name</p>
    <p><strong>Date:</strong> @selectedEvent.Date.ToString("MMMM dd, yyyy")</p>
    <p><strong>Location:</strong> @selectedEvent.Location</p>

    <a href="/register/@Uri.EscapeDataString(selectedEvent.Name)">Register for this event</a>
}
else
{
    <p>Event not found. <NavLink href="/index">Back to Events</NavLink></p>
}

@code {
    [Parameter] public string? eventName { get; set; }
    private Event? selectedEvent;

    protected override void OnParametersSet()
    {
        var events = new List<Event>
        {
            new Event { Name = "Tech Summit 2025", Date = new DateTime(2025, 12, 5), Location = "Washington, DC" },
            new Event { Name = "Global Dev Conference", Date = new DateTime(2026, 1, 20), Location = "New York, NY" },
            new Event { Name = "AI & Ethics Forum", Date = new DateTime(2026, 3, 15), Location = "Boston, MA" }
        };

        selectedEvent = events.FirstOrDefault(e => e.Name == eventName);
    }
}
